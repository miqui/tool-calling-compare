{
  "id": "tool-allowlist",
  "title": "Tool allowlist",
  "description": "Only an allowlisted subset of registered tools is exposed to the model.",
  "prompt": "Delete old.txt, or just read it if you cannot delete.",
  "tools": [
    {
      "name": "read_file",
      "description": "Read a file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "mock_result": {
        "content": "stale"
      }
    },
    {
      "name": "delete_file",
      "description": "Delete a file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "mock_result": {
        "ok": true
      }
    }
  ],
  "features": [
    "activeTools / restricted tool set"
  ],
  "stop_condition": "final_answer",
  "expect": {
    "tool_calls": [
      {
        "name": "read_file",
        "arguments": {
          "path": "old.txt"
        }
      }
    ],
    "tools_exposed": [
      "read_file"
    ],
    "steps": 2
  },
  "mock_llm_script": [
    {
      "finish_reason": "tool_calls",
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "old.txt"
          }
        }
      ]
    },
    {
      "finish_reason": "stop",
      "text": "I can only read it: stale."
    }
  ],
  "active_tools": [
    "read_file"
  ]
}
