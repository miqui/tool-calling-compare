{
  "id": "approval-gated-action",
  "description": "A destructive tool requires human approval; run once approved and once denied.",
  "prompt": "Delete the file old-report.txt.",
  "tools": [
    {"name": "delete_file", "parameters": {"path": "string"}, "requires_approval": true}
  ],
  "variants": [
    {"approval": "approve", "expect": {"tool_executed": true}},
    {"approval": "deny", "expect": {"tool_executed": false, "final_answer_mentions_denial": true}}
  ]
}
